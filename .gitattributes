# Normalise line endings so the repo is identical on Windows, macOS and Linux.
# Without this, a checkout on another machine can show every file as modified.
* text=auto eol=lf

# Shell scripts must keep LF or they break inside the containers.
*.sh text eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.docx binary
